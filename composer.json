{
    "name" : "fab2s/souuid",
    "description" : "Simple Ordered Uuid Generator in PHP",
    "type" : "library",
    "authors" : [{
        "name" : "Fabrice de Stefanis"
    }],
    "keywords" : [
        "Simple",
        "Ordered",
        "Uuid",
        "PHP",
        "SoUuid"
    ],
    "license" : [
        "MIT"
    ],
    "require" : {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "webpatser/laravel-uuid": "^6.0|^7.0",
        "ramsey/uuid": "^4.0",
        "phpunit/php-timer": "^7.0|^8.0|^9.0",
        "laravel/pint": "^1.21.2"
    },
    "suggest": {
        "ext-gmp": "To use base62 and base36 formats",
        "ext-ctype": "To use base62 and base36 formats"
    },
    "autoload": {
        "psr-4": {
            "fab2s\\SoUuid\\": "src"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "rm -rf .*.cache"
        ],
        "post-install-cmd": [
            "rm -rf .*.cache"
        ],
        "fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint --ansi --config pint.json --"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --"
        ],
        "cov": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit --colors --coverage-html ./cov --"
        ],
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php bench --"
        ]
    }
}
